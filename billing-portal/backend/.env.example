# Environment Configuration
# Copy this to .env in billing-portal/backend directory

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# Admin Configuration
ADMIN_TOKEN=your-admin-token-change-this

# Database Configuration
DATABASE_PATH=./billing.db

# CORS Configuration
CORS_ORIGIN=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Billing Configuration
DEFAULT_PLAN_DURATION=30
DEFAULT_PLAN_SPEED=20

# Email Configuration (Optional - for future notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/billing.log

# Security
PASSWORD_MIN_LENGTH=6
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# PPPoE Server Configuration
PPPOE_SERVER_IP=172.22.162.1
PPPOE_SERVER_NETMASK=255.255.255.0

# Speed Profile Configuration
SPEED_PROFILES=20,30,50,100,200,500

# Renewal Notification (days before expiry)
EXPIRY_WARNING_DAYS=3

# System Maintenance
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
